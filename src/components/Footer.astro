---
import { Image } from 'astro:assets';
import bee from '../assets/bee.png';
import { nav, site } from '../data/site';
import Social from './Social.astro';
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="who">
      <Image src={bee} alt="" width={72} widths={[72, 144]} sizes="72px" />
      <div>
        <p class="name">{site.name}</p>
        <p class="tag">{site.tagline} from the {site.decades.join(', ')}</p>
      </div>
    </div>
    <nav aria-label="Footer">
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <Social />
  </div>
  <p class="wrap fine">&copy; {new Date().getFullYear()} {site.name}. All songs are the property of their writers and we just love playing them.</p>
</footer>
<style>
  .site-footer { margin-top: auto; background: #0b0806; border-top: 2px solid var(--red); padding: 40px 0 28px; }
  .grid { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  .who { display: flex; align-items: center; gap: 14px; }
  .who img { width: 72px; }
  .name { font: 400 1.4rem/1 var(--display); color: var(--red-bright); margin: 0 0 6px; }
  .tag { font: 500 0.85rem/1.3 var(--label); text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold); margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 18px; }
  nav a { font: 500 0.95rem/2 var(--label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--cream-dim); text-decoration: none; }
  nav a:hover { color: var(--gold); }
  .fine { margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--ink-3); font-size: 0.85rem; color: #8d7f62; }
</style>
