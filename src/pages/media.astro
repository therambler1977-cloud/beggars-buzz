---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import banner from '../assets/banner.jpg';
import { captions, videos } from '../data/media';

// Every image in src/assets/photos/ shows up here, newest file name last.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}', { eager: true });
const photos = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => {
      const file = path.split('/').pop()!;
      const auto = file.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ');
      const caption = captions[file] ?? auto.charAt(0).toUpperCase() + auto.slice(1);
      const full = await getImage({ src: mod.default, width: 1600 });
      return { img: mod.default, caption, full: full.src };
    }),
);

const ytId = (url: string) =>
  url.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/)?.[1] ?? (/^[\w-]{11}$/.test(url) ? url : '');
const vids = videos.map((v) => ({ ...v, id: v.url ? ytId(v.url) : '' })).filter((v) => v.file || v.id);
---
<Base title="Photos & Video" description="Photos and live video of Beggar's Buzz, the classic rock cover band.">
  <header class="page-head">
    <div class="wrap">
      <p class="label">See and hear us</p>
      <h1>Photos & video</h1>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <h2>Live video</h2>
      {vids.length > 0 ? (
        <div class="videos">
          {vids.map((v) => (
            <figure>
              <div class:list={['frame-16x9', { portrait: v.portrait }]}>
                {v.file ? (
                  <video controls playsinline preload="none" poster={v.poster} aria-label={v.title}>
                    <source src={v.file} type="video/mp4" />
                  </video>
                ) : (
                  <iframe src={`https://www.youtube-nocookie.com/embed/${v.id}`} title={v.title} loading="lazy"
                    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe>
                )}
              </div>
              <figcaption>{v.title}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <p class="soon">Live videos are on the way. Check back soon.</p>
      )}
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap">
      <h2>Photos</h2>
      {photos.length > 0 ? (
        <ul class="photos">
          {photos.map((p) => (
            <li>
              <a href={p.full} data-caption={p.caption}>
                <Image src={p.img} alt={p.caption} widths={[360, 720]} sizes="(max-width: 600px) 50vw, 360px" />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="poster">
          <Image src={banner} alt="Beggar's Buzz poster: rock & roll songs you love from the 60s, 70s, 80s, 90s" widths={[600, 1000, 1600]} sizes="(max-width: 1120px) 100vw, 1120px" />
          <p class="soon">Gig photos coming soon.</p>
        </div>
      )}
    </div>
  </section>

  <dialog class="lightbox" aria-label="Photo">
    <form method="dialog"><button class="close" aria-label="Close">&times;</button></form>
    <img alt="" />
    <p class="cap"></p>
  </dialog>
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  const img = dlg?.querySelector('img');
  const cap = dlg?.querySelector<HTMLElement>('.cap');
  document.querySelectorAll<HTMLAnchorElement>('.photos a').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (!dlg || !img || !cap) return;
      e.preventDefault();
      img.src = a.href;
      img.alt = a.dataset.caption ?? '';
      cap.textContent = a.dataset.caption ?? '';
      dlg.showModal();
    });
  });
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  h2 { margin-bottom: 24px; }
  .videos { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr)); gap: 24px; }
  figure { margin: 0; }
  .frame-16x9 { aspect-ratio: 16 / 9; border: 2px solid var(--cream); border-radius: 4px; overflow: hidden; box-shadow: 5px 5px 0 var(--navy); background: #000; }
  .frame-16x9.portrait { aspect-ratio: 9 / 16; width: auto; height: min(70vh, 560px); max-width: 100%; margin-inline: auto; }
  .videos { align-items: start; }
  figure:has(.portrait) figcaption { text-align: center; }
  iframe, video { width: 100%; height: 100%; border: 0; display: block; object-fit: cover; }
  figcaption { margin-top: 12px; font: 500 1rem/1.3 var(--label); text-transform: uppercase; letter-spacing: 0.06em; color: var(--cream-dim); }
  .soon { color: var(--cream-dim); border: 1px dashed var(--ink-3); border-radius: var(--radius); padding: 24px; text-align: center; margin: 0; }
  .photos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(46%, 260px), 1fr)); gap: 12px; }
  .photos a { display: block; aspect-ratio: 1; overflow: hidden; border-radius: 4px; border: 1px solid var(--ink-3); }
  .photos img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.25s; }
  .photos a:hover img { transform: scale(1.04); }
  .poster img { border-radius: 4px; border: 1px solid var(--ink-3); margin-bottom: 18px; }
  .lightbox { max-width: min(1100px, 94vw); max-height: 92vh; padding: 0; border: 2px solid var(--cream); border-radius: 6px; background: var(--ink); color: var(--cream); }
  .lightbox::backdrop { background: rgba(0, 0, 0, 0.85); }
  .lightbox img { max-height: 80vh; width: auto; margin: 0 auto; }
  .cap { margin: 0; padding: 10px 16px; color: var(--cream-dim); }
  .close { position: absolute; top: 6px; right: 6px; width: 44px; height: 44px; font-size: 2rem; line-height: 1; color: var(--cream); background: rgba(0, 0, 0, 0.6); border: 0; border-radius: 50%; cursor: pointer; }
</style>
